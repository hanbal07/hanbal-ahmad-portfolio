# ─────────────────────────────────────────────────────────────
# Backend (FastAPI) environment variables
# Copy to `.env` and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# SQLAlchemy database URL. SQLite works out of the box;
# swap for Postgres in production, e.g.
# postgresql+psycopg://user:pass@host:5432/portfolio
DATABASE_URL=sqlite:///./contact.db

# ── SMTP (optional) ──────────────────────────────────────────
# Leave empty to disable email delivery; messages are still
# stored in the database and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Where contact messages get sent (your inbox).
EMAIL_TO=

# Max messages accepted per IP address per hour.
RATE_LIMIT_PER_HOUR=6