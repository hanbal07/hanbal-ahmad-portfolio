# ============================================================
# Web (Next.js) environment variables
# Copy to `.env.local` and fill in real values. All optional —
# the site ships with sane defaults for the GitHub Pages deploy.
# ============================================================

# Canonical public URL of the deployed site (used for SEO links,
# sitemap, robots.txt and Open Graph). No trailing slash.
# The CI workflow already sets this for GitHub Pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact email shown in the Contact section, the footer,
# and used as the default delivery target for the contact form.
# Defaults to the address set in src/data/site.ts.
# NEXT_PUBLIC_CONTACT_EMAIL=hanbalahmad07@gmail.com

# ============================================================
# Contact delivery
#
# By default the form posts to FormSubmit's AJAX endpoint for the
# public contact email — no signup or key needed. The address owner
# confirms delivery once via FormSubmit's activation email after
# the first submission.
#
# To deliver elsewhere instead, configure ONE of the options below.

# Option A — deploy the FastAPI backend in backend/ somewhere
# always-on (Render/Railway/Fly/VPS). The form posts JSON to:
#   {NEXT_PUBLIC_API_URL}/api/contact
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Option B — any absolute third-party form endpoint (Formspree,
# Web3Forms, etc.), e.g. https://formspree.io/f/xxxxx.
# Takes precedence over Option A when both are set.
# NEXT_PUBLIC_CONTACT_ENDPOINT=

# Request body format for Option B.
# "json" → application/json  (Web3Forms, Formspree)
# "form"  → multipart/form-data (Formspree form-action URLs)
# NEXT_PUBLIC_CONTACT_FORMAT=json

# ============================================================
# Optional: CV / resume
# Drop the file at web/public/assets/resume.pdf, or set an
# absolute URL. While empty, the "Download CV" button is hidden.
# NEXT_PUBLIC_RESUME_URL=/assets/resume.pdf
