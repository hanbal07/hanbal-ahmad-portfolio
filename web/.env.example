# ─────────────────────────────────────────────────────────────
# Web (Next.js) environment variables
# Copy to `.env.local` and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Canonical public URL of the deployed site (used for SEO links,
# sitemap, robots.txt and Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact delivery ─────────────────────────────────────────
# GitHub Pages is static, so the contact form must be wired to a
# reachable endpoint. Configure ONE of the two options below.

# Option A — deploy the FastAPI backend somewhere always-on
# (Render/Railway/Fly/VPS). The form posts JSON to:
#   {NEXT_PUBLIC_API_URL}/api/contact
# Leave empty if you use Option B instead.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Option B — a third-party static-site form endpoint (Formspree,
# Web3Forms, etc.). Absolute URL, e.g. https://formspree.io/f/xxxxx.
# Takes precedence over NEXT_PUBLIC_API_URL when both are set.
# NEXT_PUBLIC_CONTACT_ENDPOINT=

# Request body format for the endpoint in Option B.
# "json" → application/json  (Web3Forms, Formspree)
# "form" → multipart/form-data (Formspree form-action URLs)
# NEXT_PUBLIC_CONTACT_FORMAT=json