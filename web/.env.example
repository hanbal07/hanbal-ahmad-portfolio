# ─────────────────────────────────────────────────────────────
# Web (Next.js) environment variables
# Copy to `.env.local` and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Canonical public URL of the deployed site (used for SEO links,
# sitemap, robots.txt and Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the FastAPI backend (contact form posts to
# {NEXT_PUBLIC_API_URL}/api/contact). Leave empty to disable
# the form until the backend is deployed.
NEXT_PUBLIC_API_URL=http://localhost:8000